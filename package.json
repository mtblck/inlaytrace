{
  "name": "inlaytrace-monorepo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "vendor": "node scripts/vendor-vtracer.mjs",
    "fonts": "node scripts/build-fonts.mjs",
    "dev": "npm run vendor && vite -c apps/app/vite.config.ts",
    "build": "npm run vendor && npm run hosting:check && npm run lint && npm run site:build && vite build -c apps/app/vite.config.ts && node scripts/check-hosting.mjs --dist",
    "preview": "node scripts/serve.mjs",
    "test": "npm run vendor && vitest run",
    "lint": "tsc -p apps/app && tsc -p packages/inlay",
    "hosting:check": "node scripts/check-hosting.mjs",
    "verify": "node scripts/verify.mjs",
    "score": "node scripts/score.mjs",
    "site:sync": "node scripts/sync-docs.mjs",
    "site:build": "npm run site:sync && astro build --root apps/site",
    "site:dev": "npm run site:sync && astro dev --root apps/site",
    "site:assets": "node scripts/site-assets.mjs"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@visioncortex/vtracer": "1.0.0-alpha.4",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "29.1.1",
    "playwright": "1.64.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
