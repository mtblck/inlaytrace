{
  "name": "inlaytrace-monorepo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "fonts": "node scripts/build-fonts.mjs",
    "dev": "vite -c apps/app/vite.config.ts",
    "build": "npm run hosting:check && npm run lint && npm run build -w packages/inlay && npm run site:build && vite build -c apps/app/vite.config.ts && node scripts/check-hosting.mjs --dist",
    "preview": "node scripts/serve.mjs",
    "test": "vitest run",
    "lint": "tsc -p apps/app && tsc -p packages/inlay && tsc -p server",
    "hosting:check": "node scripts/check-hosting.mjs",
    "verify": "node scripts/verify.mjs",
    "score": "node scripts/score.mjs",
    "site:sync": "node scripts/sync-docs.mjs",
    "site:build": "npm run site:sync && astro build --root apps/site",
    "site:dev": "npm run site:sync && astro dev --root apps/site",
    "site:assets": "node scripts/site-assets.mjs",
    "version-packages": "changeset version && npm install --package-lock-only",
    "score:photos": "node scripts/score-photos.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@visioncortex/vtracer": "1.0.0-alpha.4",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "29.1.1",
    "playwright": "1.64.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@vercel/blob": "2.8.0",
    "fast-png": "8.0.0",
    "jpeg-js": "0.4.4",
    "onnxruntime-node": "1.30.0"
  },
  "overrides": {
    "postcss-nested": "^7.0.2"
  }
}
