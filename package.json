{
  "name": "img-to-svg",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "vendor": "node scripts/vendor-vtracer.mjs",
    "fonts": "node scripts/build-fonts.mjs",
    "dev": "npm run vendor && vite",
    "build": "npm run vendor && npm run hosting:check && tsc -b && vite build",
    "preview": "vite preview",
    "test": "npm run vendor && vitest run",
    "lint": "tsc -b --noEmit",
    "hosting:check": "node scripts/check-hosting.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "svgo": "4.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@visioncortex/vtracer": "1.0.0-alpha.4",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "29.1.1",
    "playwright": "1.64.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
