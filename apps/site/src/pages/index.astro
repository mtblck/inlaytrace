---
/**
 * The landing page. Everything on it comes from the real tracers:
 * src/data/sample.json is generated by scripts/site-assets.mjs from the app's
 * sample badge, so the shapes, the close-up and the numbers are measured. The
 * 2048 px timings are the exception: timed by hand (docs/design-notes.md).
 */
import Page from '../layouts/Page.astro'
import sample from '../data/sample.json'
import { parsePath } from 'inlaytrace'

/** The app (apps/app), served beside this site. */
const APP = '/app/'
const description =
  'Inlay traces logos, illustrations, line art and pixel art into SVG. Every edge between two colours is traced once and shared, so the shapes fit together exactly. Free, open source, runs in your browser.'
/** Flip when inlaytrace is on npm (#55). */
const PUBLISHED = true

type Shape = { d: string; fill: string; transform?: string }
const size = sample.size
const centre = size / 2

const crop = sample.crop
const view = `${crop.x} ${crop.y} ${crop.w} ${crop.h}`
/** Anchor points inside the close-up, to show where each tracer put its nodes. */
const nodesIn = (shapes: Shape[]) =>
  shapes.flatMap((p) => {
    const t = p.transform?.match(/translate\(([-\d.]+)[ ,]+([-\d.]+)\)/)
    const dx = t ? Number(t[1]) : 0
    const dy = t ? Number(t[2]) : 0
    return parsePath(p.d)
      .flatMap((s) => s.nodes)
      .map((n) => ({ x: n.x + dx, y: n.y + dy }))
      .filter((n) => n.x >= crop.x && n.x <= crop.x + crop.w && n.y >= crop.y && n.y <= crop.y + crop.h)
  })
const inlayNodes = nodesIn(sample.inlay as Shape[])
const vtNodes = nodesIn(sample.percolour as Shape[])
const art = sample.art.replace(/<svg[^>]*>/, '').replace(/<\/svg>\s*$/, '')
const artViewBox = sample.art.match(/viewBox="([^"]+)"/)?.[1] ?? `0 0 ${size} ${size}`
const [ax, ay, aw] = artViewBox.split(/[\s,]+/).map(Number)
// The art's own coordinates for the crop (it may not be drawn at 640).
const s = aw / size
const artView = `${ax + crop.x * s} ${ay + crop.y * s} ${crop.w * s} ${crop.h * s}`
const dot = crop.w / 90
---

<Page title="Inlay: trace images into vector shapes that fit together" description={description}>
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-text">
          <h1 id="hero-title">Vector shapes, cut to fit.</h1>
          <p class="lede">
            Inlay traces logos, illustrations, line art and pixel art into SVG. Every edge between two colours is traced once and shared by both
            shapes, so they fit together exactly, like inlaid wood.
          </p>
          <div class="actions">
            <a class="button" href={APP}>Trace an image</a>
            <div class="install">
              <code id="install-cmd">npm install inlaytrace</code>
              {PUBLISHED ? <button type="button" class="copy" data-copy="install-cmd">Copy</button> : <span class="soon">Coming to npm</span>}
            </div>
          </div>
          <p class="fine">Free and open source. Runs in your browser: your image is never uploaded.</p>
        </div>

        <figure class="print" aria-labelledby="hero-caption">
          {/* A loop of how Inlay works, rendered with the isogram kit. Muted and inline; landing.ts starts it
              unless the reader prefers reduced motion, when the poster frame (the edges being traced) stays. */}
          <video
            class="hero-video"
            id="hero-video"
            width="800"
            height="600"
            muted
            loop
            playsinline
            preload="auto"
            poster="/media/png-to-svg.webp"
            aria-label="An isometric conveyor: a pixel image goes in as PNG, a gantry scans its pixels, the edges between colours are traced, and flat vector shapes come out as SVG."
          >
            <source src="/media/png-to-svg.webm" type="video/webm" />
            <source src="/media/png-to-svg.mp4" type="video/mp4" />
          </video>
          <figcaption id="hero-caption">
            <span>Pixels in, shapes out: every edge between two colours is traced once.</span>
            <button type="button" class="replay" id="replay" aria-controls="hero-video">Pause</button>
          </figcaption>
        </figure>
      </section>

      <section class="evidence" aria-labelledby="evidence-title">
        <h2 id="evidence-title">Shapes a designer would draw</h2>
        <p class="section-lede">
          A 48 px square of the badge: the left peak and its snowcap. Inlay keeps the straight edges straight and the summit sharp; a
          tracer that smooths each colour's outline on its own lets them wander. The dots are each tracer's nodes.
        </p>
        <div class="trio">
          <figure>
            <svg viewBox={artView} role="img" aria-label="The clean source art"><Fragment set:html={art} /></svg>
            <figcaption><strong>The source art</strong><span>The clean art. Both tracers got it as a 640 px JPEG</span></figcaption>
          </figure>
          <figure>
            <svg viewBox={view} role="img" aria-label="Inlay's trace of the same square">
              {(sample.inlay as Shape[]).map((p) => <path d={p.d} fill={p.fill} />)}
              {inlayNodes.map((n) => <circle class="node" cx={n.x} cy={n.y} r={dot} />)}
            </svg>
            <figcaption><strong>Inlay</strong><span>{sample.wrongInWindow.inlay} px wrong here, {inlayNodes.length} nodes</span></figcaption>
          </figure>
          <figure>
            <svg viewBox={view} role="img" aria-label="VTracer's trace of the same square">
              {(sample.percolour as Shape[]).map((p) => <path d={p.d} fill={p.fill} transform={p.transform} />)}
              {vtNodes.map((n) => <circle class="node" cx={n.x} cy={n.y} r={dot} />)}
            </svg>
            <figcaption><strong>VTracer</strong><span>{sample.wrongInWindow.percolour} px wrong here, {vtNodes.length} nodes</span></figcaption>
          </figure>
        </div>

        <table class="numbers">
          <caption>The whole badge, rendered at 4× and compared with the clean art</caption>
          <thead>
            <tr><th scope="col"></th><th scope="col">Inlay</th><th scope="col">VTracer</th></tr>
          </thead>
          <tbody>
            <tr><th scope="row">Pixels wrong</th><td>{sample.wrongPct.inlay.toFixed(2)}%</td><td>{sample.wrongPct.percolour.toFixed(2)}%</td></tr>
            <tr><th scope="row">Nodes</th><td>{sample.nodes.inlay}</td><td>{sample.nodes.percolour}</td></tr>
            <tr><th scope="row">Time for a 2048 px image</th><td>1.3 s</td><td>17.5 s</td></tr>
          </tbody>
        </table>
        <p class="fine">
          VTracer is the excellent open-source tracer, run with the settings the Logo preset used before Inlay replaced it. <a href="/docs/how-it-works/measuring-quality/">How
          these are measured</a>.
        </p>
      </section>

      <section class="ways" aria-labelledby="ways-title">
        <h2 id="ways-title">Two ways to use it</h2>
        <div class="two">
          <div>
            <h3>In the app</h3>
            <p>
              Drop in a PNG, JPG or WebP. Compare the trace with the original, fix colours and shapes, then download an SVG, PDF, EPS or PNG, or a
              zip with one SVG per colour for screen printing and vinyl.
            </p>
            <p><a class="button secondary" href={APP}>Open the app</a></p>
          </div>
          <div>
            <h3>In your code</h3>
            <pre><code>{`import { trace, toSvg, peakPalette } from 'inlaytrace'

const result = trace(rgba, width, height, {
  mode: 'palette',
  palette: peakPalette(rgba, 8),
  speckle: 8,
  tolerance: 1,
  cornerAngle: 45,
})

result.paths // [{ d, fill }, …]
toSvg(result) // '<svg …>'`}</code></pre>
            <p>
              Pure TypeScript, no WebAssembly: browsers, Web Workers and Node. <a href="/docs/package/getting-started/">Getting started</a>
            </p>
          </div>
        </div>
      </section>
  <script src="../scripts/landing.ts"></script>
</Page>
