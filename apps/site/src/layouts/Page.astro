---
/**
 * The shell shared by the site's own pages (the landing page, the SVG editor
 * page, Privacy and Terms): head, header, footer and the floating tip button. The docs are
 * Starlight's and have their own.
 */
import { tipjar } from 'tipjar'
import 'tipjar/style.css'
import '../styles/fonts.css'
import '../styles/landing.css'
import { CONTACT, SUPPORT } from '../data/legal'

interface Props {
  title: string
  description: string
  /** On phones, swap the header's app button for a floating one (the landing page, whose hero has its own). */
  floatingApp?: boolean
}
const { title, description, floatingApp = false } = Astro.props
/** Inlay is free; this floating button asks for a tip. It tucks away when the footer, with its own support link, is on screen. */
const tip = tipjar({ href: SUPPORT, label: 'Support Inlay', description: 'on Ko-fi', icon: 'heart', newTab: true })
/** On a phone the floating button would cover the page, so the tip sits in the sticky header instead. */
const headerTip = tipjar({ href: SUPPORT, label: 'Support Inlay', description: 'on Ko-fi', icon: 'heart', newTab: true, position: 'inline', compact: 'always', className: 'top-tip' })
/** The app (apps/app), served beside this site. */
const APP = '/app/'
/** The footer's columns. */
const FOOTER = [
  {
    title: 'Inlay',
    links: [
      { label: 'Open the app', href: APP },
      { label: 'SVG editor', href: '/svg-editor/' },
      { label: 'Support Inlay', href: SUPPORT },
    ],
  },
  {
    title: 'Learn',
    links: [
      { label: 'Docs', href: '/docs/overview/' },
      { label: 'Use the package', href: '/docs/package/getting-started/' },
      { label: 'Compared with other tools', href: '/docs/how-it-differs/' },
    ],
  },
  {
    title: 'Open source',
    links: [
      { label: 'Source on GitHub', href: 'https://github.com/mtblck/inlaytrace' },
      { label: 'inlaytrace on npm', href: 'https://www.npmjs.com/package/inlaytrace' },
      { label: 'Report a problem', href: 'https://github.com/mtblck/inlaytrace/issues' },
    ],
  },
  {
    title: 'Legal',
    links: [
      { label: 'Privacy', href: '/privacy/' },
      { label: 'Terms', href: '/terms/' },
      { label: 'Contact', href: `mailto:${CONTACT}` },
    ],
  },
]
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <!-- The theme picked in the docs' menu (Starlight's key), before first paint. Its sha256 is in vercel.json's CSP. -->
    <script is:inline>
      try {
        const t = localStorage.getItem('starlight-theme')
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t
      } catch {}
    </script>
    <!-- Page views for mattblack.space/analytics; skipped on localhost. A file, so no CSP hash. -->
    <script is:inline src="/analytics.js" defer></script>
  </head>
  <body>
    <header class="top">
      <a class="wordmark" href="/" aria-label="Inlay, home">
        <!-- The mark from brand/mark-dark.svg; its square turns green on light pages (brand/mark.svg). -->
        <svg class="logo-mark" viewBox="0 0 128 128" aria-hidden="true"><path class="logo-mark-square" d="M0 0H128V56A72 72 0 0 0 56 128H0Z" /><path d="M128 56V128H56A72 72 0 0 1 128 56Z" fill="#f2c230" /></svg>Inlay
      </a>
      <nav aria-label="Site">
        <a href="/docs/package/getting-started/">Docs</a>
        <a class:list={['button small', { 'top-app': floatingApp }]} href={APP}>Open the app</a>
        <Fragment set:html={headerTip} />
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="foot">
      <div class="foot-about">
        <a class="wordmark" href="/">Inlay</a>
        <p>Image to SVG in your browser, with shapes that fit together exactly. Free and open source.</p>
        <p class="foot-fine">MIT licensed. Made by <a href="https://mattblack.space">Matt Black</a>.</p>
      </div>
      <nav class="foot-cols" aria-label="Footer">
        {
          FOOTER.map((col) => (
            <div>
              <h2>{col.title}</h2>
              <ul>
                {col.links.map((l) => (
                  <li>
                    <a href={l.href}>{l.label}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </footer>

    <Fragment set:html={tip} />
    {
      floatingApp && (
        <a class="button float-app" href={APP} hidden>
          Trace an image, free
        </a>
      )
    }
    <script>
      import { tuck } from 'tipjar'

      const button = document.querySelector<HTMLElement>('.tipjar:not(.top-tip)')
      if (button) tuck(button, 'footer.foot')

      // Phones: the floating app button shows once the hero's own button has scrolled away, until the footer.
      const float = document.querySelector<HTMLElement>('.float-app')
      const hero = document.querySelector('.hero .actions')
      const foot = document.querySelector('footer.foot')
      if (float && hero && foot) {
        let pastHero = false
        let atFoot = false
        const show = () => float.toggleAttribute('data-show', pastHero && !atFoot)
        float.hidden = false
        new IntersectionObserver(([e]) => {
          pastHero = !e.isIntersecting && e.boundingClientRect.top < 0
          show()
        }).observe(hero)
        new IntersectionObserver(([e]) => {
          atFoot = e.isIntersecting
          show()
        }).observe(foot)
      }
    </script>

  </body>
</html>
