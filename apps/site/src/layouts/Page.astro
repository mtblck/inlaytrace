---
/**
 * The shell shared by the site's own pages (the landing page, Pricing, Privacy,
 * Terms and Refunds):
 * head, header and footer. The docs are Starlight's and have their own.
 */
import '../styles/fonts.css'
import '../styles/landing.css'
import { CONTACT } from '../data/legal'

interface Props {
  title: string
  description: string
}
const { title, description } = Astro.props
/** The app (apps/app), served beside this site. */
const APP = '/app/'
/** The footer's columns. Every page Paddle's review looks for (pricing, terms, refunds, privacy) must stay in here. */
const FOOTER = [
  {
    title: 'Inlay',
    links: [
      { label: 'Open the app', href: APP },
      { label: 'Pricing', href: '/pricing/' },
      { label: 'Support Inlay', href: 'https://ko-fi.com/mtblck' },
    ],
  },
  {
    title: 'Learn',
    links: [
      { label: 'Docs', href: '/docs/overview/' },
      { label: 'Use the package', href: '/docs/package/getting-started/' },
      { label: 'Compared with other tools', href: '/docs/how-it-differs/' },
    ],
  },
  {
    title: 'Open source',
    links: [
      { label: 'Source on GitHub', href: 'https://github.com/mtblck/inlaytrace' },
      { label: 'inlaytrace on npm', href: 'https://www.npmjs.com/package/inlaytrace' },
      { label: 'Report a problem', href: 'https://github.com/mtblck/inlaytrace/issues' },
    ],
  },
  {
    title: 'Legal',
    links: [
      { label: 'Privacy', href: '/privacy/' },
      { label: 'Terms', href: '/terms/' },
      { label: 'Refunds', href: '/refunds/' },
      { label: 'Contact', href: `mailto:${CONTACT}` },
    ],
  },
]
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- The theme picked in the docs' menu (Starlight's key), before first paint. Its sha256 is in vercel.json's CSP. -->
    <script is:inline>
      try {
        const t = localStorage.getItem('starlight-theme')
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t
      } catch {}
    </script>
  </head>
  <body>
    <header class="top">
      <a class="wordmark" href="/" aria-label="Inlay, home">Inlay</a>
      <nav aria-label="Site">
        <a href="/docs/package/getting-started/">Docs</a>
        <a href="/pricing/">Pricing</a>
        <a href={APP}>App</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="foot">
      <div class="foot-about">
        <a class="wordmark" href="/">Inlay</a>
        <p>Image to SVG in your browser, with shapes that fit together exactly. Free and open source.</p>
        <p class="foot-fine">MIT licensed. Made by <a href="https://mattblack.space">Matt Black</a>.</p>
      </div>
      <nav class="foot-cols" aria-label="Footer">
        {
          FOOTER.map((col) => (
            <div>
              <h2>{col.title}</h2>
              <ul>
                {col.links.map((l) => (
                  <li>
                    <a href={l.href}>{l.label}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </footer>

  </body>
</html>
