---
/**
 * The shell shared by the site's own pages (the landing page, the SVG editor
 * page, Privacy and Terms): head, header, footer and the floating tip button. The docs are
 * Starlight's and have their own.
 */
import { tipjar } from 'tipjar'
import 'tipjar/style.css'
import '../styles/fonts.css'
import '../styles/landing.css'
import { CONTACT, SUPPORT } from '../data/legal'

interface Props {
  title: string
  description: string
}
const { title, description } = Astro.props
/** Inlay is free; this floating button asks for a tip. It tucks away when the footer, with its own support link, is on screen. */
const tip = tipjar({ href: SUPPORT, label: 'Support Inlay', description: 'on Ko-fi', icon: 'heart', newTab: true })
/** The app (apps/app), served beside this site. */
const APP = '/app/'
/** The footer's columns. */
const FOOTER = [
  {
    title: 'Inlay',
    links: [
      { label: 'Open the app', href: APP },
      { label: 'SVG editor', href: '/svg-editor/' },
      { label: 'Support Inlay', href: SUPPORT },
    ],
  },
  {
    title: 'Learn',
    links: [
      { label: 'Docs', href: '/docs/overview/' },
      { label: 'Use the package', href: '/docs/package/getting-started/' },
      { label: 'Compared with other tools', href: '/docs/how-it-differs/' },
    ],
  },
  {
    title: 'Open source',
    links: [
      { label: 'Source on GitHub', href: 'https://github.com/mtblck/inlaytrace' },
      { label: 'inlaytrace on npm', href: 'https://www.npmjs.com/package/inlaytrace' },
      { label: 'Report a problem', href: 'https://github.com/mtblck/inlaytrace/issues' },
    ],
  },
  {
    title: 'Legal',
    links: [
      { label: 'Privacy', href: '/privacy/' },
      { label: 'Terms', href: '/terms/' },
      { label: 'Contact', href: `mailto:${CONTACT}` },
    ],
  },
]
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- The theme picked in the docs' menu (Starlight's key), before first paint. Its sha256 is in vercel.json's CSP. -->
    <script is:inline>
      try {
        const t = localStorage.getItem('starlight-theme')
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t
      } catch {}
    </script>
    <!-- Page views for mattblack.space/analytics; skipped on localhost. A file, so no CSP hash. -->
    <script is:inline src="/analytics.js" defer></script>
  </head>
  <body>
    <header class="top">
      <a class="wordmark" href="/" aria-label="Inlay, home">Inlay</a>
      <nav aria-label="Site">
        <a href="/docs/package/getting-started/">Docs</a>
        <a class="button small" href={APP}>Open the app</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="foot">
      <div class="foot-about">
        <a class="wordmark" href="/">Inlay</a>
        <p>Image to SVG in your browser, with shapes that fit together exactly. Free and open source.</p>
        <p class="foot-fine">MIT licensed. Made by <a href="https://mattblack.space">Matt Black</a>.</p>
      </div>
      <nav class="foot-cols" aria-label="Footer">
        {
          FOOTER.map((col) => (
            <div>
              <h2>{col.title}</h2>
              <ul>
                {col.links.map((l) => (
                  <li>
                    <a href={l.href}>{l.label}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </footer>

    <Fragment set:html={tip} />
    <script>
      import { tuck } from 'tipjar'

      const button = document.querySelector<HTMLElement>('.tipjar')
      if (button) tuck(button, 'footer.foot')
    </script>

  </body>
</html>
