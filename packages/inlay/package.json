{
  "name": "inlaytrace",
  "version": "0.1.1",
  "description": "Trace images into SVG shapes that share their edges exactly: no gaps, no overlaps. Pure TypeScript, no WebAssembly.",
  "type": "module",
  "license": "MIT",
  "author": "Matt Black (https://mattblack.space)",
  "homepage": "https://github.com/mtblck/inlaytrace/tree/main/packages/inlay#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mtblck/inlaytrace.git",
    "directory": "packages/inlay"
  },
  "bugs": "https://github.com/mtblck/inlaytrace/issues",
  "keywords": [
    "vectorize",
    "vectorization",
    "trace",
    "image-tracing",
    "bitmap-to-vector",
    "raster-to-vector",
    "svg",
    "pixel-art"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsdown",
    "check": "publint --strict && attw --pack --profile esm-only",
    "test": "vitest run --root ../..  packages/inlay",
    "typecheck": "tsc -p .",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "fflate": "0.8.3",
    "publint": "0.3.25",
    "tsdown": "0.23.1"
  }
}
